          "content": {
            "size": 11059,
            "mimeType": "application/javascript",
            "text": "var websocket;\r\nvar connected = false;\r\nvar opening = false;\r\nvar closing = false;\r\n\r\nvar WorkerOpCode = {\r\n   OPEN: 1,\r\n   SEND: 0,\r\n   CLOSE: -1\r\n};\r\nvar WorkerStatusCode = {\r\n   CONNECTION_FAILED: -3,\r\n   ERROR: -2,\r\n   DISCONNECTED: -1,\r\n   RECV: 0,\r\n   CONNECTED: 1,\r\n   INFO: 2,\r\n   PROGRESS: 3,\r\n   ALREADY_CONNECTED: 4\r\n};\r\nvar connectionTimerID = 0;\r\nvar portConnectionStatus = {};\r\nvar timeOfFirstOpenWebSocketAttempt = 0;\r\n\r\nfunction getWorkerCurTime() {\r\n   var today = new Date();\r\n   return today.getFullYear() + \"-\" + (today.getMonth() + 1) + \"-\" + today.getDate() + \":\" + today.getHours() + \":\" + today.getMinutes() + \":\" + today.getSeconds() + \":\" + today.getMilliseconds();\r\n}\r\n\r\n/**\r\n * Open a websocket connection to a web socket server listening on the given address and port.\r\n *\r\n * @param connectionData object containing following information:\r\n *        address: address (ip or dns hostname) of web socket server\r\n *        port: port of last connection to web socket server\r\n *        launchId: launchId of last connection to web socket server\r\n *        language: language of client (e.g. 'en')\r\n *        numTriesMax: Max number of attempts to connect to given address and random port\r\n *        numTried: Number of attempts already made to connect to given address and random port\r\n *        nextTryWaitPeriodMilliseconds: number of milliseconds to wait before next attempt to connect on random port\r\n */\r\nfunction openWebSocketForWorker(connectionData) {\r\n   var protocol = connectionData.protocol;\r\n   var address = connectionData.address;\r\n   var port = connectionData.port;\r\n   var launchId = connectionData.launchId;\r\n   var language = connectionData.language ? connectionData.language : 'en';\r\n   var url = protocol + \"://\" + address + \":\" + port + \"/CTF/\" + launchId + \"?lang=\" + language;\r\n   var ws;\r\n\r\n   try {\r\n      if (connectionData.numTried == 0)\r\n         portConnectionStatus['' + port] = true;\r\n\r\n      connectionData.numTried += 1;\r\n      postMessage({\r\n         status: WorkerStatusCode.INFO,\r\n         connectionData: connectionData\r\n      });\r\n      console.log(getWorkerCurTime() + \" \" + \"openWebSocketForWorker: attempting to connect on port=\" + connectionData.port + \" , try=\" + connectionData.numTried);\r\n      ws = new WebSocket(url);\r\n   } catch (e) {\r\n      console.warn(getWorkerCurTime() + \" \" + \"openWebSocketForWorker ERROR: Caught exception connecting with url \" + url + \": \" + e.message);\r\n      postMessage({\r\n         status: WorkerStatusCode.ERROR,\r\n         connectionData: connectionData,\r\n         reason: e.message\r\n      });\r\n      return;\r\n   }\r\n\r\n   ws.onopen = function(event) {\r\n      console.log(getWorkerCurTime() + \" \" + \"WebSocket onopen: connected to: \" + url);\r\n      if (connectionTimerID != 0) {\r\n         clearTimeout(connectionTimerID);\r\n         connectionTimerID = 0;\r\n      }\r\n      postMessage({\r\n         status: WorkerStatusCode.CONNECTED,\r\n         connectionData: connectionData\r\n      })\r\n      opening = false;\r\n      closing = false;\r\n      connected = true;\r\n      websocket = ws;\r\n   };\r\n\r\n   ws.onconnected = function(event) {\r\n      console.log(getWorkerCurTime() + \" \" + \"WebSocket onconnected: connected to: \" + url);\r\n      postMessage({\r\n         status: WorkerStatusCode.ALREADY_CONNECTED,\r\n         connectionData: connectionData\r\n      })\r\n   };\r\n\r\n   ws.onerror = function(event) {\r\n      console.log(getWorkerCurTime() + \" \" + \"WebSocket onerror:\");\r\n      if (!connected) {\r\n         if (connectionData.numTriesMax == 0 || connectionData.numTried >= connectionData.numTriesMax) {\r\n            if (connectionData.numTried >= connectionData.numTriesMax)\r\n               console.log(getWorkerCurTime() + \" \" + 'dt=' + (Date.now() - timeOfFirstOpenWebSocketAttempt) + ' milliseconds');\r\n\r\n            opening = false;\r\n            if (connectionTimerID != 0) {\r\n               clearTimeout(connectionTimerID);\r\n               connectionTimerID = 0;\r\n            }\r\n\r\n            if (event.data)\r\n               console.log(getWorkerCurTime() + \" \" + \"WebSocket onerror: \" + event.data);\r\n\r\n            postMessage({\r\n               status: WorkerStatusCode.CONNECTION_FAILED,\r\n               connectionData: connectionData,\r\n               eventData: event.data\r\n            });\r\n            connected = false;\r\n            websocket = null;\r\n            return;\r\n         }\r\n\r\n         if (connectionData.numTriesMax > 0 && connectionData.numTried < connectionData.numTriesMax) {\r\n            var status = portConnectionStatus['' + port];\r\n            if (status) {\r\n               console.log(getWorkerCurTime() + \" \" + 'dt=' + ((Date.now() - timeOfFirstOpenWebSocketAttempt) / 10.) + ' milliseconds');\r\n               connectionTimerID = setTimeout(openWebSocketForWorker,\r\n                  connectionData.nextTryWaitPeriodMilliseconds,\r\n                  connectionData);\r\n            }\r\n         } else {\r\n            opening = false;\r\n            if (event.data)\r\n               console.log(getWorkerCurTime() + \" \" + \"WebSocket onerror: \" + event.data);\r\n            postMessage({\r\n               status: WorkerStatusCode.CONNECTION_FAILED,\r\n               connectionData: connectionData,\r\n               eventData: event.data\r\n            });\r\n            connected = false;\r\n            websocket = null;\r\n            return;\r\n         }\r\n      } else {\r\n         opening = false;\r\n         var msg = \"WebSocket onerror\";\r\n         if (event.data)\r\n            msg += \": \" + event.data;\r\n         console.warn(getWorkerCurTime() + \" \" + msg);\r\n         if (!closing) {\r\n            postMessage({\r\n               status: WorkerStatusCode.ERROR,\r\n               connectionData: connectionData,\r\n               eventData: event.data\r\n            });\r\n         } else {\r\n            closing = false;\r\n            postMessage({\r\n               status: WorkerStatusCode.DISCONNECTED,\r\n               connectionData: connectionData\r\n            });\r\n         }\r\n         connected = false;\r\n         websocket = null;\r\n      }\r\n   };\r\n\r\n   ws.onclose = function(event) {\r\n      console.log(getWorkerCurTime() + \" \" + \"WebSocket onclose invoked \");\r\n      if (connected) {\r\n         var eventMsg = \"code=\" + event.code;\r\n         if (event.reason)\r\n            eventMsg += \", reason=\" + event.reason;\r\n         eventMsg += \", wasClean=\" + event.wasClean;\r\n         console.log(getWorkerCurTime() + \" \" + \"WebSocket onclose: disconnected from: \" + url + \", \" + eventMsg);\r\n         postMessage({\r\n            status: WorkerStatusCode.DISCONNECTED,\r\n            connectionData: connectionData\r\n         });\r\n      }\r\n      closing = false;\r\n      connected = false;\r\n      websocket = null;\r\n   };\r\n\r\n   ws.onmessage = function(event) {\r\n      console.log(getWorkerCurTime() + \" \" + \"WebSocket onmessage: \" + event.data);\r\n      // forward message from CTF to web page\r\n      var message;\r\n      try {\r\n         message = JSON.parse(event.data);\r\n         if (message.progress != undefined) {\r\n            postMessage({\r\n               status: WorkerStatusCode.PROGRESS,\r\n               message: message\r\n            });\r\n         } else\r\n         if (message.connectionFailed) {\r\n            connected = false;\r\n            opening = false;\r\n            postMessage({\r\n               status: WorkerStatusCode.CONNECTION_FAILED,\r\n               message: message,\r\n               connectionData: connectionData\r\n            });\r\n            portConnectionStatus['' + port] = false;\r\n            if (connectionTimerID != 0) {\r\n               clearTimeout(connectionTimerID);\r\n               connectionTimerID = 0;\r\n            }\r\n            closeWebSocketForWorker();\r\n         } else\r\n         if (message.closing) {\r\n            connected = false;\r\n            opening = false;\r\n            portConnectionStatus['' + port] = false;\r\n            postMessage({\r\n               status: WorkerStatusCode.ERROR,\r\n               message: message,\r\n               connectionData: connectionData\r\n            });\r\n            if (connectionTimerID != 0) {\r\n               clearTimeout(connectionTimerID);\r\n               connectionTimerID = 0;\r\n            }\r\n            closeWebSocketForWorker();\r\n         } else {\r\n            postMessage({\r\n               status: WorkerStatusCode.RECV,\r\n               message: message,\r\n               connectionData: connectionData\r\n            });\r\n         }\r\n      } catch (e) {\r\n         console.warn(getWorkerCurTime() + \" \" + \"WebSocket onmessage: invalid event.data: \" + e.message);\r\n      }\r\n   };\r\n\r\n   return ws;\r\n}\r\n\r\nfunction closeWebSocketForWorker() {\r\n   if (websocket) {\r\n      closing = true;\r\n      var msg = \"Closed by client\";\r\n      websocket.close(1000, msg);\r\n      console.log(getWorkerCurTime() + \" \" + \"closeWebsocket: called websocket.close(1000, '\" + msg + \"')\");\r\n      websocket = null;\r\n   }\r\n}\r\n\r\nonmessage = function(event) {\r\n   console.log(getWorkerCurTime() + \" \" + \"Worker recv: \" + JSON.stringify(event.data));\r\n\r\n   var message;\r\n   try {\r\n      message = event.data;\r\n   } catch (e) {\r\n      console.warn(getWorkerCurTime() + \" \" + \"Worker error: Invalid JSON message string\");\r\n      return;\r\n   }\r\n\r\n   if (message.opcode === undefined || typeof(message.opcode) !== 'number') {\r\n      console.log(getWorkerCurTime() + \" \" + \"Worker error: Missing or invalid message opcode\");\r\n      return;\r\n   }\r\n\r\n   var opcode = message.opcode;\r\n   if (opcode < WorkerOpCode.CLOSE || WorkerOpCode.OPEN < opcode) {\r\n      console.log(getWorkerCurTime() + \" \" + \"Worker error: Invalid message opcode value: \" + opcode);\r\n      return;\r\n   }\r\n\r\n   switch (opcode) {\r\n      case WorkerOpCode.OPEN: {\r\n         if (connected) {\r\n            console.log(getWorkerCurTime() + \" \" + \"Worker OPEN: already connected\");\r\n            websocket.onconnected();\r\n            return;\r\n         }\r\n\r\n         if (!connected && opening) {\r\n            console.log(getWorkerCurTime() + \" \" + \"Worker OPEN: waiting to open\");\r\n            return;\r\n         }\r\n\r\n         opening = true;\r\n         console.log(getWorkerCurTime() + \" \" + \"Worker: opening web socket connection on port \" + message.connectionData.port);\r\n         timeOfFirstOpenWebSocketAttempt = Date.now();\r\n         openWebSocketForWorker(message.connectionData);\r\n         break;\r\n      }\r\n      case WorkerOpCode.CLOSE: {\r\n         if (!connected) {\r\n            console.log(getWorkerCurTime() + \" \" + \"Worker CLOSE:  already disconnected\");\r\n            return;\r\n         }\r\n\r\n         if (connected && closing) {\r\n            console.log(getWorkerCurTime() + \" \" + \"Worker CLOSE:  waiting to close\");\r\n            return;\r\n         }\r\n\r\n         console.log(getWorkerCurTime() + \" \" + \"Worker CLOSE:  closeWebSocketForWorker\");\r\n         closeWebSocketForWorker();\r\n         break;\r\n      }\r\n      case WorkerOpCode.SEND: {\r\n         console.log(getWorkerCurTime() + \" \" + \"Worker SEND: \" + JSON.stringify(message.data));\r\n         websocket.send(message.data); // forward message from web page to CTF\r\n         break;\r\n      }\r\n   }\r\n}"
