          "cookies": [],
          "content": {
            "size": 9452,
            "mimeType": "text/html",
            "compression": -21,
            "text": "<!DOCTYPE html><html><head><base href=\"/home/appworks_tips/app/start/web/\"><link href=\"/cordys/favicon.ico\" rel=\"shortcut icon\" type=\"image/x-icon\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" charset=\"UTF-8\"><link rel=\"stylesheet\" type=\"text/css\" href=\"./startup.css\"><link rel=\"stylesheet\" type=\"text/css\" href=\"./thirdpartylibs/pivot.min.css\"><!-- cordova and appworks script (un-comment when building for AppWorks, tablet app will pick up below, do not change format) --><!--<script src=\"cordova.js\"></script>--><!--<script src=\"appworks.min.js\"></script>--><!--<script src=\"./appworks/microapp-config.js\"></script>--><!-- cordova/appworks--><!--script src=\"./thirdpartylibs/BigDecimal.js\"></script --><!-- csrf will be located in wcp/library/system  --><!-- <script src=\"/cordys/wcp/library/system/csrf.js\"></script> --><!-- csrf temporarily in thirdpartylibs to avoid login issues for developers  --><script src=\"./thirdpartylibs/csrf.js\"></script><script>document.addEventListener('gesturestart', function(e) {\n         e.preventDefault();\n      });\n      var publicAPIProvider = {};\n      var publicInternalAPIProvider = {};\n      var emp = {};\n      var CKEDITOR_BASEPATH = '';\n      emp.defaultOrgName = 'system';\n      emp.getCookieData = function(name) {\n         var value = \"; \" + document.cookie;\n         var parts = value.split(\"; \" + name + \"=\");\n         if (parts.length == 2) return parts.pop().split(\";\").shift();\n      };\n      if (window.location.port !== '') {\n         emp.service = window.location.protocol + '//' + window.location.hostname + ':' + window.location.port;\n      } else {\n         emp.service = window.location.protocol + '//' + window.location.hostname;\n      }\n      emp.serviceBase = '/home/' + emp.defaultOrgName + '/app/';\n      emp.orgUrl = '/home/' + emp.defaultOrgName;\n      let appIdx = window.location.pathname.indexOf('/app/');\n      if (appIdx !== -1) {\n         emp.serviceBase = window.location.pathname.substr(0, appIdx + '/app/'.length);\n         emp.orgUrl = window.location.pathname.substr(0, appIdx);\n         CKEDITOR_BASEPATH = emp.service + emp.orgUrl + '/thirdparty/ckeditor/';\n      } else {\n         //localhost:9000\n         CKEDITOR_BASEPATH = emp.service + '/home/' + emp.defaultOrgName + '/thirdparty/ckeditor/';\n      }\n      if (window.microAppConfig) {\n         emp.serviceBase = '/'+window.microAppConfig.awbasepath+'/'+window.microAppConfig.aworganization+'/app/';\n         emp.orgUrl = '/'+window.microAppConfig.awbasepath+'/'+window.microAppConfig.aworganization;\n\n         if(typeof Appworks !== 'undefined' && Appworks.Auth) {\n            let appworksdetail =   new Promise((resolve, reject) => {\n            let auth = new Appworks.Auth(\n            function(data) {\n                  Appworks.authData = data.authData;\n                  let response;\n                  let xhr = new XMLHttpRequest();\n                  let url = Appworks.authData.gatewayUrl + microAppConfig.awgSettingsRestPath + microAppConfig.appName\n                  xhr.open('get', url);\n                  xhr.setRequestHeader('Authorization', Appworks.authData.authorizationHeader.Authorization);\n                  xhr.send();\n\n                  xhr.onload = function() {\n                     response = xhr.response;\n                     let appWorksSettings = JSON.parse(response);\n                     appWorksSettings.forEach(function(a, b, c) {\n                        sessionStorage.setItem(a.key, a.value);\n                     });\n\n                     microAppConfig.aworganization = sessionStorage.getItem(microAppConfig.appName + '.' + microAppConfig.settingsOrgName) || microAppConfig.aworganization;\n                     microAppConfig.serverName = sessionStorage.getItem(microAppConfig.appName + '.' + microAppConfig.settingsServiceUrlName) || microAppConfig.serverName;\n                     emp.service = microAppConfig.serverName;\n\n                     CKEDITOR_BASEPATH = emp.service +'/' + microAppConfig.awbasepath + '/'+ microAppConfig.aworganization + '/thirdparty/ckeditor/';\n                     \n                  };\n                  resolve('Success');\n               }.bind(this),\n               function(error) {\n                  console.log(JSON.stringify(err));\n                  reject(JSON.stringify(err));\n               });\n               auth.authenticate();\n            });\n         }\n      }\n      emp.serviceURL = emp.service + emp.serviceBase;\n      let baseElement = document.getElementsByTagName('base');\n      if (baseElement.length && baseElement[0].getAttribute(\"href\") === '/') {\n         emp.rootPath = '/';\n      } else {\n         emp.rootPath = emp.serviceBase + 'start/web/';\n      }\n      emp.mobile = '../mobile';\n      emp.language = 'en-GB';\n      //cookie keys will be set in main.js\n      emp.cookieKeys = {};\n      emp.getContextBaseUrlWithAppMarker = function() {\n         return '/' + document.location.href.split('/').slice(3, 5).join('/');\n      }\n      emp.getContextStartUrl = function() {\n         if (this.getContextBaseUrlWithAppMarker().length > 2) {\n            return this.getContextBaseUrlWithAppMarker();\n         } else {\n            return '/home/' + emp.defaultOrgName;\n         }\n      }\n\n       //Global array  ie clientLoadingProgress will contain atleast one entry  ie 'appLoading' until either RGC or Grid starts loading.\n      emp.clientLoadingProgress = [];\n      emp.clientLoadingProgress.push('appLoading');\n      /** emp.clientLoadingProgress = [];\n      emp.clientLoadingProgress.push('appLoading');\n      emp.clientLoading = new Promise((resolve, reject)=>{\n         let globalTimer = setInterval(()=>{\n            //Resolve the promise object once global array is empty, ie. RGC, GRID and rule execution will update the global array before rendering and remove entry once they are loaded.\n            if(emp.clientLoadingProgress.length === 0){\n               window.clearTimeout(globalTimer);\n               resolve();\n            }\n         },1000);\n      }); **/</script></head><body aurelia-app=\"./main\" style=\"position:absolute; top:0; bottom:0; right:0; left:0;overflow:hidden;\"><div class=\"busy box\"><div class=\"inner load\"><div class=\"outside-loader\"><div class=\"loader\"><div class=\"inside-loader\"></div></div></div><div id=\"busyText\"></div></div></div><script src=\"jspm_packages/system.js\"></script><script src=\"config.js\"></script><script>// Internet Explorer 6-11\n      var isIE = /*@cc_on!@*/ false || !!document.documentMode;\n\n      // Edge 20+\n      var isEdge = !isIE && !!window.StyleMedia;\n      // safari 3.0+ \n      var isSafari = /constructor/i.test(window.HTMLElement) || (function(p) {\n         return p.toString() === \"[object SafariRemoteNotification]\";\n      })(!window['safari'] || (typeof safari !== 'undefined' && safari.pushNotification));\n\n      if (!window.Intl || isIE || isEdge || isSafari) {\n         System.import('./jspm_packages/npm/intl@1.2.5').then(function(intlPolyfill) {\n            System.import('./jspm_packages/npm/intl@1.2.5/locale-data/jsonp/en.js');\n            if (!window.Intl) {\n               window.Intl = intlPolyfill;\n            } else {\n               window.Intl.NumberFormat = intlPolyfill.NumberFormat;\n               window.Intl.DateTimeFormat = intlPolyfill.DateTimeFormat;\n            }\n         });\n      }\n\n      //Fix for Aurelia i18N plugin use of Number.isInteger in relative time value converter\n      //Number.isInteger also currently used in results list filter by range\n      if (!Number.isInteger) {\n         Number.isInteger = function(value) {\n            return typeof value === 'number' && isFinite(value) && Math.floor(value) === value;\n         };\n      }\n\n      System.import('bluebird').then(function(Promise) {\n         Promise.