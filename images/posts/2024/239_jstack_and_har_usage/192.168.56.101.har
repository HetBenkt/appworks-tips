            "text": "/*\nThe CSRF javascript is available via URL:\n\n/cordys/wcp/library/system/csrf.js\n\nAfter loading, an object called 'CSRFProtection' is available with the following API:\n\nCSRFProtection.getToken( callbackFunction )\n\nThe function getToken() accepts one parameter, which is a callback function.\nThis function will be called with two parameters, the name and value of the CRSF token.\nWith these parameters a URL parameter must be added to Cordys WebGateway calls that trigger modifications.\n\nExample usage:\n\n<html>\n<head>\n    <script type=\"text/javascript\" src=\"/cordys/wcp/library/system/csrf.js\"></script>\n    <script type=\"text/javascript\">\n        var someUrl = \"http://localhost/path\";\n\n        function showCSRFToken(event) {\n            CSRFProtection.getToken( function(name, value) {\n                alert(\"URL with the CSRF token is: \" + someUrl + \"?\" + name + \"=\" + value);\n            });\n        }\n    </script>\n</head>\n\n<body>\n    <h1>CSRF library test</h1>\n    <button type=\"button\" onclick=\"showCSRFToken(event)\">Get CSRF token</button>\n</body>\n</html>\n\nBe sure not to leak the CSRF token to a domain other than where the page is loaded from.\n*/\n(function(object) {\n\t'use strict';\n\tvar csrfTokenName = \"\";\n\tvar samlArtCookieName = \"\";\n\tvar cookieTemplate = \"$VALUE; path=/\";\n\n\tfunction getXHR() {\n\t\tvar XHR = XMLHttpRequest || ActiveXObject; //NOMBV(2)\n\t\treturn new XHR('MSXML2.XMLHTTP.3.0');\n\t}\n\n\tfunction getToken(callback) {\n\t\tif (csrfTokenName) {\n\t\t\treturn doCallback(callback);\n\t\t}\n\t\t\n\t\tvar xhr = getXHR();\n\t\txhr.onreadystatechange = function() {\n\t\t\tif (xhr.readyState == 4) {\n\t\t\t\tif(xhr.status == 200) {\n\t\t\t\t\tcsrfTokenName = getTagContentFromResponse(xhr.responseText,\"CheckName\");\n\t\t\t\t\tsamlArtCookieName = getTagContentFromResponse(xhr.responseText,\"SamlArtifactCookieName\");\n\t\t\t\t}\n\t\t\t\tdoCallback(callback);\n\t\t\t}\n\t\t}\n\t\t// Adding organization context & authID to prelogininfo request\n\t\tvar authIDParam = '';\n\t\tvar authIDVal = getQueryParam(window.location.href, 'authID');\n\t\tif (authIDVal) {\n\t\t\tauthIDParam = '?authID=' + authIDVal;\r\n        }\n\t\tvar prelogininfourl = emp.orgUrl + '/' + \"com.eibus.sso.web.authentication.PreLoginInfo.wcp\" + authIDParam;\n\t\txhr.open(\"GET\", prelogininfourl, true);\n\t\txhr.send(null);\n\t}\n\n\tfunction doCallback(callback) {\n\t\tvar csrfToken = null;\n\t\tif (csrfTokenName) {\n\t\t\tvar csrfCookie = getCookie(csrfTokenName);\n\t\t\tif (!csrfCookie) {\n\t\t\t\tcsrfToken = generateGuid();\n\t\t\t\tcsrfCookie = cookieTemplate.replace(\"$VALUE\", csrfToken);\n\t\t\t\tsetCookie(csrfTokenName, csrfCookie);\n\t\t\t}\n\t\t\telse {\n\t\t\t\tcsrfToken = csrfCookie;\n\t\t\t}\n\t\t}\n\t\tcallback.call(this, csrfTokenName, csrfToken, samlArtCookieName);\n\t}\n\n\t// private\n\tfunction generateGuid() {\n\t\treturn ([1e7] + -1e3 + -4e3 + -8e3 + -1e11).replace(/[018]/g, function (c) { return (c ^ getRandomByte() & 15 >> c / 4).toString(16) });\n\t}\n\n\t// private\n\tfunction getRandomByte() {\n\t\tif (typeof (window.crypto) === 'undefined' || typeof (window.crypto.getRandomValues) === 'undefined') {\n\t\t\treturn Math.random() * 16;\n\t\t}\n\t\treturn crypto.getRandomValues(new Uint8Array(1))[0]\n\t}\n\n\tfunction getTagContentFromResponse(response, name) {\n\t\tvar regexp = new RegExp(\"<\" + name + \".*>([^<]*)<\\/\" + name + \">\");\n\t\tvar match = response.match(regexp);\n\t\treturn match && match.length > 0 ? match[1] : null;\n\t}\n\t\n\tfunction getCookie(cookieName) {\n\t\tvar cookies = document.cookie.split(\";\");\n\t\tfor (var i = 0; i < cookies.length; ++i) {\n\t\t\tvar cookie = cookies[i];\n\t\t\tvar pair = cookie.split(\"=\");\n\n\t\t\tif (trim(pair[0]) == cookieName) {\n\t\t\t\treturn pair.length == 1 ? \"\" : cookie.substring(pair[0].length+1);\n\t\t\t}\n\t\t}\n\t\treturn null;\n\t}\n\n\tfunction setCookie(cookieName,cookieValue)\n\t{\n\t\tdocument.cookie = cookieName + \"=\" + cookieValue;\n\t}\n\n\tfunction deleteCookie(cookieName)\n\t{\n\t\tvar cookieValue = cookieTemplate.replace(\"$VALUE\", \";expires=Thu, 01-Jan-1970 00:00:01 GMT\");\n\t\tsetCookie(cookieName, cookieValue);\n\t}\n\n\tfunction trim(string) {\n\t\treturn string ? string.match(/^\\s*(.*)\\s*$/)[1] : string;\n\t}\n\n\tfunction getQueryParam(url, key) {\r\n\t\tlet params = (new URL(url)).searchParams;\r\n\t\tlet value = params.get(key);\r\n\t\treturn value && decodeURIComponent(value.replace(/\\+/g, ' '));\r\n\t}\n\n\tif (typeof (object.CSRFProtection) === 'undefined') {\n\t\tobject.CSRFProtection = {\n\t\t\tgetToken : function(callback) { return getToken(callback); }\n\t\t};\n\t}\n})(window);\n\n"
