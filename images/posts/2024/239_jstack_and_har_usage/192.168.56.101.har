            "text": ".busy-container {\r\n    position: relative;\r\n}\r\n\r\n.hide-component-busy-indicator {\r\n    display: none !important;\r\n}\r\n\r\n.busy {\r\n    display: table;\r\n    background-color: rgba(255,255,255,.85);\r\n    text-align: center;\r\n    width: 100%;\r\n    height: 100%;\r\n    z-index: 10;\r\n    top: 0;\r\n}\r\n\r\n.busy.saving {\r\n    background-color: transparent;\r\n}\r\n\r\n.busy>.inner {\r\n    display: table-cell;\r\n    vertical-align: middle;\r\n}\r\n\r\n.busy>.inner>span {\r\n    visibility: hidden;\r\n    background-position: top center;\r\n    background-repeat: no-repeat;\r\n    display: inline-block;\r\n    line-height: 2rem;\r\n    font-size: 1.6rem;\r\n    padding-top: 45px;\r\n    color: #009be7;\r\n    font-weight: bold;\r\n    text-shadow: 1px 1px 1px rgba(255, 255, 255, .65);\r\n}\r\n\r\nbody>.busy {\r\n    position: fixed;\r\n}\r\n\r\n/*UX2 loading indicator, there may be updated CSS for this but I can't find it*/\r\n\r\n.load .loader {\r\n    height: 72px;\r\n    width: 72px;\r\n    font-size:0.625rem;\r\n    text-indent: -9999em;\r\n    border-radius: 50%;\r\n    border-top: 1.5em solid #d6d5e8;\r\n    border-right: 1.5em solid #d6d5e8;\r\n    border-bottom: 1.5em solid #d6d5e8;\r\n    border-left: 1.5em solid #2e3d98;\r\n    -webkit-transform: translateZ(0);\r\n    -ms-transform: translateZ(0);\r\n    transform: translateZ(0);\r\n    -webkit-animation: load8 1.8s infinite linear;\r\n    animation: load8 1.8s infinite linear;\r\n}\r\n\r\n.inside-loader{\r\n    height: 42px;\r\n    width: 42px;\r\n    border-radius: 50%;\r\n    border: 5px solid #ffffff;\r\n\r\n}\r\n\r\n.outside-loader{\r\n    height: 82px;\r\n    width: 82px;\r\n    margin: 2em auto;\r\n    position: relative;\r\n    border-radius: 50%;\r\n    border: 5px solid #ffffff;\r\n}\r\n\r\n.load .loader:after {\r\n    border-radius: 50%;\r\n    width: 4.5em;\r\n    height: 4.5em;\r\n}\r\n\r\n@-webkit-keyframes load8 {\r\n    0% {\r\n        -webkit-transform: rotate(0deg);\r\n        transform: rotate(0deg);\r\n    }\r\n    100% {\r\n        -webkit-transform: rotate(360deg);\r\n        transform: rotate(360deg);\r\n    }\r\n}\r\n\r\n@keyframes load8 {\r\n    0% {\r\n        -webkit-transform: rotate(0deg);\r\n        transform: rotate(0deg);\r\n    }\r\n    100% {\r\n        -webkit-transform: rotate(360deg);\r\n        transform: rotate(360deg);\r\n    }\r\n}\r\n\r\n::-webkit-scrollbar-thumb {\r\n    background: #767676;\r\n    border-radius: 10px;\r\n}\r\n\r\n::-webkit-scrollbar-track {\r\n    background: #DCDCDC;\r\n}\r\n\r\n::-webkit-scrollbar {\r\n    width: 6px;\r\n    height: 6px;\r\n}\r\n\r\nbody {\r\n    scrollbar-face-color: #767676;\r\n    scrollbar-face-width: 4px;\r\n    scrollbar-shadow-color: #2D2C4D;\r\n    scrollbar-highlight-color: #7D7E94;\r\n    scrollbar-darkshadow-color: #2D2C4D;\r\n    scrollbar-track-color: #DCDCDC;\r\n    scrollbar-arrow-color: #C1C1D1;\r\n}\r\n\r\n@font-face {\r\n    font-family: \"Aktiv grotesk\";\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    src: url(\"./fonts/fonts/OpenTextSans_W_Rg.woff\") format('woff');\r\n    text-rendering: optimizeLegibility;\r\n}\r\n\r\n@font-face {\r\n    font-family: \"Aktiv grotesk\";\r\n    src: url(\"./fonts/fonts/OpenTextSans_W_Bd.woff\") format('woff');\r\n    font-weight: bold;\r\n    font-style: normal;\r\n    text-rendering: optimizeLegibility;\r\n}\n/*!\n * Bootstrap v4.0.0 (https://getbootstrap.com)\n * Copyright 2011-2018 The Bootstrap Authors\n * Copyright 2011-2018 Twitter, Inc.\n * Licensed under MIT (https://github.com/twbs/bootstrap/blob/master/LICENSE)\n */:root{--blue:#007bff;--indigo:#6610f2;--purple:#6f42c1;--pink:#e83e8c;--red:#dc3545;--orange:#fd7e14;--yellow:#ffc107;--green:#28a745;--teal:#20c997;--cyan:#17a2b8;--white:#fff;--gray:#6c757d;--gray-dark:#343a40;--primary:#007bff;--secondary:#6c757d;--success:#28a745;--info:#17a2b8;--warning:#ffc107;--danger:#dc3545;--light:#f8f9fa;--dark:#343a40;--breakpoi