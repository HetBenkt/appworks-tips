\":\"F8B156B4FF8F11E6E6562305FE2D7F32\",\"containerVersionId\":\"6550dfdcfc863508a5afbc5ceff0a9de\",\"displayName\":\"Roles\",\"parentId\":\"F8B156B4FF8F11E6EB5ED78F449B7F8A\",\"usage\":{\"sourceId\":\"34EB610D9CBA4D5C9D0EB4343DF8F9B3\",\"sourceName\":\"Form\",\"chrome\":\"full\",\"itemPath\":null,\"relationPath\":null,\"loadDefaultLayoutTab\":false,\"customCSS\":null,\"panelMaxHeight\":null,\"actionbarAlignment\":null,\"dockPanel\":false,\"customExtensions\":null,\"customScriptQualifiedName\":null,\"categories\":null,\"criteria\":\"\\\"\\\\\\\"null\\\\\\\"\\\"\",\"discussionDateFormat\":null,\"navigationSelection\":false,\"properties\":[{\"name\":\"formId\",\"value\":\"0050568172D511E6EF18FE6F339C3D6E\"},{\"name\":\"layoutContainerVersionId\",\"value\":null}],\"formId\":\"0050568172D511E6EF18FE6F339C3D6E\",\"formContainerVersionId\":\"6550dfdcfc863508a5afbc5ceff0a9de\",\"systemVariables\":{\"systemVariableValues\":[{\"name\":\"organization\",\"value\":\"appworks_tips\"},{\"name\":\"baseURL\",\"value\":\"/home/appworks_tips/\"},{\"name\":\"baseDomain\",\"value\":\"baseDomain\"}]}}},{\"id\":\"F8B156B4FF8F11E6EB5ED78F44989F8A\",\"name\":\"Form1\",\"typeId\":\"AA6700E8B24A44B28EBB5DA7FF44FDB4\",\"type\":\"Panel\",\"containerId\":\"F8B156B4FF8F11E6E6562305FE2D7F32\",\"containerVersionId\":\"6550dfdcfc863508a5afbc5ceff0a9de\",\"displayName\":\"Summary\",\"parentId\":\"F8B156B4FF8F11E6EB5ED78F449B7F8A\",\"usage\":{\"sourceId\":\"34EB610D9CBA4D5C9D0EB4343DF8F9B3\",\"sourceName\":\"Form\",\"chrome\":\"full\",\"itemPath\":null,\"relationPath\":null,\"loadDefaultLayoutTab\":false,\"customCSS\":null,\"panelMaxHeight\":null,\"actionbarAlignment\":null,\"dockPanel\":false,\"customExtensions\":null,\"customScriptQualifiedName\":null,\"categories\":null,\"criteria\":\"\\\"\\\\\\\"null\\\\\\\"\\\"\",\"discussionDateFormat\":null,\"navigationSelection\":false,\"properties\":[{\"name\":\"formId\",\"value\":\"3417EB967E4611E6EF611981BC5BDDDD\"},{\"name\":\"layoutContainerVersionId\",\"value\":null}],\"formId\":\"3417EB967E4611E6EF611981BC5BDDDD\",\"formContainerVersionId\":\"6550dfdcfc863508a5afbc5ceff0a9de\",\"systemVariables\":{\"systemVariableValues\":[{\"name\":\"organization\",\"value\":\"appworks_tips\"},{\"name\":\"baseURL\",\"value\":\"/home/appworks_tips/\"},{\"name\":\"baseDomain\",\"value\":\"baseDomain\"}]}}},{\"id\":\"00505681199811E6EF2DCEB89DDF5F76\",\"name\":\"Form2\",\"typeId\":\"AA6700E8B24A44B28EBB5DA7FF44FDB4\",\"type\":\"Panel\",\"containerId\":\"F8B156B4FF8F11E6E6562305FE2D7F32\",\"containerVersionId\":\"6550dfdcfc863508a5afbc5ceff0a9de\",\"displayName\":\"Groups\",\"parentId\":\"F8B156B4FF8F11E6EB5ED78F449B7F8A\",\"usage\":{\"sourceId\":\"34EB610D9CBA4D5C9D0EB4343DF8F9B3\",\"sourceName\":\"Form\",\"chrome\":\"full\",\"itemPath\":null,\"relationPath\":null,\"loadDefaultLayoutTab\":false,\"customCSS\":null,\"panelMaxHeight\":null,\"actionbarAlignment\":null,\"dockPanel\":false,\"customExtensions\":null,\"customScriptQualifiedName\":null,\"categories\":null,\"criteria\":\"\\\"\\\\\\\"null\\\\\\\"\\\"\",\"discussionDateFormat\":null,\"navigationSelection\":false,\"properties\":[{\"name\":\"formId\",\"value\":\"00505681199811E6EF2DCEB89DE29F76\"},{\"name\":\"layoutContainerVersionId\",\"value\":null}],\"formId\":\"00505681199811E6EF2DCEB89DE29F76\",\"formContainerVersionId\":\"6550dfdcfc863508a5afbc5ceff0a9de\",\"systemVariables\":{\"systemVariableValues\":[{\"name\":\"organization\",\"value\":\"appworks_tips\"},{\"name\":\"baseURL\",\"value\":\"/home/appworks_tips/\"},{\"name\":\"baseDomain\",\"value\":\"baseDomain\"}]}}},{\"id\":\"3417EB967E4611E6EF614DF69F48FDDD\",\"name\":\"Breadcrumbs\",\"typeId\":\"AA6700E8B24A44B28EBB5DA7FF44FDB4\",\"type\":\"Panel\",\"containerId\":\"F8B156B4FF8F11E6E6562305FE2D7F32\",\"containerVersionId\":\"6550dfdcfc863508a5afbc5ceff0a9de\",\"displayName\":\"Breadcrumbs\",\"parentId\":\"F8B156B4FF8F11E6EB5ED78F449B7F8A\",\"usage\":{\"sourceId\":\"F2F761CA44844DBABCEDD7B6FF1EEBDD\",\"sourceName\":\"Breadcrumbs\",\"chrome\":\"full\",\"itemPath\":null,\"relationPath\":null,\"loadDefaultLayoutTab\":false,\"customCSS\":null,\"panelMaxHeight\":null,\"actionbarAlignment\":null,\"dockPanel\":false,\"customExtensions\":null,\"customScriptQualifiedName\":null,\"categories\":null,\"criteria\":\"\\\"\\\\\\\"null\\\\\\\"\\\"\",\"discussionDateFormat\":null,\"navigationSelection\":false,\"properties\":[]}},{\"id\":\"F8B156B4FF8F11E6F0DAFC6F81BB5F63\",\"name\":\"Form3\",\"typeId\":\"AA6700E8B24A44B28EBB5DA7FF44FDB4\",\"type\":\"Panel\",\"containerId\":\"F8B156B4FF8F11E6E6562305FE2D7F32\",\"containerVersionId\":\"6550dfdcfc863508a5afbc5ceff0a9de\",\"displayName\":\"Form\",\"parentId\":\"F8B156B4FF8F11E6EB5ED78F449B7F8A\",\"usage\":{\"sourceId\":\"34EB610D9CBA4D5C9D0EB4343DF8F9B3\",\"sourceName\":\"Form\",\"chrome\":\"none\",\"itemPath\":null,\"relationPath\":null,\"loadDefaultLayoutTab\":false,\"customCSS\":null,\"panelMaxHeight\":null,\"actionbarAlignment\":null,\"dockPanel\":false,\"customExtensions\":null,\"customScriptQualifiedName\":null,\"categories\":null,\"criteria\":\"\\\"\\\\\\\"null\\\\\\\"\\\"\",\"discussionDateFormat\":null,\"navigationSelection\":false,\"properties\":[{\"name\":\"formId\",\"value\":\"F8B156B4FF8F11E6F0DAE6555D051F63\"},{\"name\":\"layoutContainerVersionId\",\"value\":null}],\"formId\":\"F8B156B4FF8F11E6F0DAE6555D051F63\",\"formContainerVersionId\":\"6550dfdcfc863508a5afbc5ceff0a9de\",\"systemVariables\":{\"systemVariableValues\":[{\"name\":\"organization\",\"value\":\"appworks_tips\"},{\"name\":\"baseURL\",\"value\":\"/home/appworks_tips/\"},{\"name\":\"baseDomain\",\"value\":\"baseDomain\"}]}}}]},\"dictionaryCache\":\"1g_W8CP2EIv00BEavP8u_Mgji25UCJ48ng0piQOra2E=\"}}"
